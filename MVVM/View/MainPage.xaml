<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel ="clr-namespace:IrzGuardPro.MVVM.ViewModel"
             x:Class="IrzGuardPro.MainPage">
	<ContentPage.BindingContext>
		<viewmodel:MainViewModel/>
	</ContentPage.BindingContext>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="10*"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<VerticalStackLayout
      Grid.Row="0"
            Padding="30,0"
            Spacing="24">
			<Image
                Source="irz.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="ИРЗ эмблема" />
			<Picker x:Name="ComboBox_AccessLevel" Title="Уровень доступа" FontSize="28" 
              SemanticProperties.Description= "Уровень доступа для генерации кода доступа."
              SelectedIndexChanged="ComboBox_AccessLevel_SelectedIndexChanged" />
			<Label
                x:Name="LabelCodePassFuture"
                Text = "{Binding Future_data.Label_str}"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                FontSize="27"
                SemanticProperties.Description="Код доступа для будуйщего часа." />
			<Label
                x:Name="LabelCodePass"
                Text="{Binding Now_date.Label_str}"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                FontSize="35"
                TextColor="Green"
                SemanticProperties.Description="Код доступа на текущий момент." />
			<Label
                x:Name="LabelCodePassPast"
                Text= "{Binding Past_data.Label_str}"
                FontSize="27"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                SemanticProperties.Description="Код доступа для прошлого часа." />

			<Button
                x:Name="InvateBtn"
                Text="Пригласи коллегу" 
                SemanticProperties.Hint="go to Invate page "
                Clicked="ToInvateBtnPage"
                HorizontalOptions="Center" />
		</VerticalStackLayout>
		<Label      
			          FontSize="16"
                Text="{Binding Now_date.Version}"
                x:Name="Label_info"
                Grid.Column="0"
                Grid.Row="1"
                HorizontalOptions="Center"
                VerticalOptions="Center"
			          
      />
	</Grid>
