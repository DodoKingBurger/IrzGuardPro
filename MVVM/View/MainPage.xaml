                x:Name="InfoDeviceBtn"
                Text="Информация об устройстве" 
                SemanticProperties.Hint="go to InfoDevice page "
                Clicked="ToInfoDevicePage"
                HorizontalOptions="Fill" />-->
	<!--

  </ScrollView>-->

</ContentPage>
